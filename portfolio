<script>
const listings = [
  { id:1, emoji:'📷', title:'Sony A7III + 50mm Lens', cat:'Camera', owner:'Ahmed K., Karachi', price:2500, deposit:15000, rating:'4.9 ★', badge:'verified', bg:'#e8f0e9' },
  { id:2, emoji:'🔧', title:'DeWalt Power Drill Set', cat:'Tools', owner:'Bilal R., Lahore', price:800, deposit:5000, rating:'4.8 ★', badge:'popular', bg:'#fdf0e8' },
  { id:3, emoji:'💻', title:'MacBook Pro M2 16&quot;', cat:'Electronics', owner:'Sara M., Islamabad', price:4000, deposit:30000, rating:'5.0 ★', badge:'verified', bg:'#e8f0e9' },
  { id:4, emoji:'⛺', title:'4-Person Camping Tent', cat:'Camping', owner:'Usman T., Karachi', price:1200, deposit:8000, rating:'4.7 ★', badge:'verified', bg:'#fdf0e8' },
  { id:5, emoji:'📷', title:'DJI Mavic 3 Drone', cat:'Camera', owner:'Hina A., Lahore', price:3500, deposit:25000, rating:'4.9 ★', badge:'popular', bg:'#e8f0e9' },
  { id:6, emoji:'👗', title:'Designer Sherwani Set (L)', cat:'Fashion', owner:'Zara K., Karachi', price:3000, deposit:20000, rating:'4.8 ★', badge:'verified', bg:'#fdf0e8' },
  { id:7, emoji:'🎒', title:'Hiking Backpack 70L', cat:'Camping', owner:'Faisal B., Islamabad', price:600, deposit:4000, rating:'4.6 ★', badge:'verified', bg:'#e8f0e9' },
  { id:8, emoji:'🔊', title:'JBL PA Speaker System', cat:'Electronics', owner:'Hamza N., Lahore', price:2200, deposit:12000, rating:'4.9 ★', badge:'popular', bg:'#fdf0e8' },
];

let currentCat = 'all';

function renderListings(data) {
  const grid = document.getElementById('listingsGrid');
  grid.innerHTML = data.map(l => `
    <div class=&quot;listing-card&quot; onclick=&quot;openModal(${l.id})&quot;>
      <div class=&quot;listing-img&quot; style=&quot;background:${l.bg}&quot;>
        ${l.emoji}
        <span class=&quot;listing-badge ${l.badge === 'verified' ? 'badge-verified' : 'badge-popular'}&quot;>
          ${l.badge === 'verified' ? '✓ Verified' : '🔥 Popular'}
        </span>
      </div>
      <div class=&quot;listing-body&quot;>
        <div class=&quot;listing-title&quot;>${l.title}</div>
        <div class=&quot;listing-owner&quot;><span class=&quot;owner-dot&quot;></span>${l.owner}</div>
        <div class=&quot;listing-footer&quot;>
          <div class=&quot;listing-price&quot;>PKR ${l.price.toLocaleString()} <span>/ day</span></div>
          <div class=&quot;listing-rating&quot;>⭐ ${l.rating}</div>
        </div>
      </div>
    </div>
  `).join('');
}

function filterListings(btn, cat) {
  document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  currentCat = cat;
  const filtered = cat === 'all' ? listings : listings.filter(l => l.cat === cat);
  renderListings(filtered);
}

function filterCat(cat) {
  const btn = [...document.querySelectorAll('.filter-pill')].find(b => b.textContent.includes(cat));
  if(btn) { filterListings(btn, cat); }
  scrollTo('listings');
}

function doSearch() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const filtered = q ? listings.filter(l => l.title.toLowerCase().includes(q) || l.cat.toLowerCase().includes(q)) : listings;
  renderListings(filtered);
  scrollTo('listings');
}

function openModal(id) {
  const l = listings.find(x => x.id === id);
  document.getElementById('modalEmoji').textContent = l.emoji;
  document.getElementById('modalTitle').textContent = l.title;
  document.getElementById('modalOwner').textContent = '🪪 ' + l.owner;
  document.getElementById('modalPrice').innerHTML = `PKR ${l.price.toLocaleString()} <small>/ day</small>`;
  document.getElementById('modalDeposit').innerHTML = `<span class=&quot;modal-feature-icon&quot;>💰</span> Security deposit: PKR ${l.deposit.toLocaleString()}`;
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('dateFrom').value = today;
  document.getElementById('modal').classList.add('open');
}

function closeModal(e) {
  if(e.target.id === 'modal') document.getElementById('modal').classList.remove('open');
}

function bookItem() {
  document.getElementById('modal').classList.remove('open');
  showToast('🎉 Booking request sent! Owner will confirm shortly.');
}

function setTab(btn) {
  document.querySelectorAll('.search-tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
}

function scrollTo(id) {
  document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}

// Init
renderListings(listings);

// Set min date
const today = new Date().toISOString().split('T')[0];
document.getElementById('dateFrom').min = today;
document.getElementById('dateTo').min = today;
</script>

